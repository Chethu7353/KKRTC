# KKRTC Where Is My Bus? – Environment Variables
# Copy to .env and fill in real values for production.

DEBUG=True
SECRET_KEY=kkrtc-dev-only-change-in-production-2026
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,10.0.2.2

# PostgreSQL / PostGIS
POSTGRES_DB=kkrtc_db
POSTGRES_USER=kkrtc_user
POSTGRES_PASSWORD=kkrtc_secret_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

# CORS
CORS_ALLOW_ALL_ORIGINS=True
