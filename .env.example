# KKRTC Where Is My Bus? – Environment Variables Template
# Copy this file to .env and provide your deployment-specific secrets.

DEBUG=True
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,10.0.2.2

# PostgreSQL / PostGIS Database
POSTGRES_DB=kkrtc_db
POSTGRES_USER=kkrtc_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

# CORS Settings
CORS_ALLOW_ALL_ORIGINS=True
